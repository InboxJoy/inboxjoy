{
  "name": "@inboxjoy/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "affiliate:admin": "tsx --env-file=../../.env src/scripts/affiliate-admin.ts",
    "billing:admin": "tsx --env-file=../../.env src/scripts/billing-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@inboxjoy/composio": "workspace:*",
    "@inboxjoy/config": "workspace:*",
    "@inboxjoy/core": "workspace:*",
    "@inboxjoy/db": "workspace:*",
    "@inboxjoy/email": "workspace:*",
    "@inboxjoy/smtp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-auth": "^1.7.2",
    "dodopayments": "^2.48.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.1",
    "posthog-node": "^5.52.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
