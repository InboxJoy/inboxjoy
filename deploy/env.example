# InboxJoy self-hosted configuration.
#
# deploy/install.sh turns this template into /opt/inboxjoy/.env and fills in
# the required values. Every setting is explained in
# docs/self-hosting/configuration.md.
#
# After editing, apply the change with:  inboxjoy restart
#
# Rules for this file:
#   - One KEY=value per line, no spaces around "=", no quotes needed.
#   - If a value contains a "$" sign, wrap it in single quotes: PASS='ab$cd'
#   - Keep this file private (mode 600) and include it in your off-server
#     backups: without AUTH_SECRET and MAILBOX_CREDENTIALS_KEY a restored
#     database cannot be used.

# ---- Required (the installer fills these in) --------------------------------

# Which release to run. The installer pins a version; `inboxjoy upgrade`
# changes it.
INBOXJOY_VERSION=latest
# Your domain, without https:// (for example inboxjoy.example.com). Its DNS A
# record must point at this server.
APP_DOMAIN=
# Receives certificate expiry notices from Let's Encrypt.
ACME_EMAIL=
# selfhost = the open-source edition. Do not change.
INBOXJOY_EDITION=selfhost
# invite: the first account becomes the owner, everyone else needs an invitation.
# open: anyone who finds the site can create an account.
SIGNUP_MODE=invite
# Derived from APP_DOMAIN. If you change the domain, change all four.
API_BASE_URL=
WEB_BASE_URL=
CORS_ORIGINS=
BETTER_AUTH_URL=
# Random secrets generated for you. Never change or delete these once data exists.
AUTH_SECRET=
POSTGRES_PASSWORD=
# One-time token that lets only you create the first account (the owner). The
# installer generates it and puts it in the setup link it prints at the end
# (https://your-domain/app/setup?token=...). It stops mattering once the owner
# exists. Keep it private until then.
SETUP_TOKEN=
# Connect any mailbox with an SMTP/IMAP app password. The key encrypts those
# passwords in the database (base64, 32 bytes).
SMTP_MAILBOXES_ENABLED=true
MAILBOX_CREDENTIALS_KEY=

# ---- System email (password resets, invitations, alerts) ---------------------
# docs/self-hosting/system-email.md
#MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
#MAIL_FROM=noreply@example.com
#MAIL_REPLY_TO=

# ---- AI drafting (optional) -------------------------------------------------
# docs/self-hosting/ai.md
#AI_API_KEY=
#AI_MODEL=
#AI_BASE_URL=https://api.openai.com/v1

# ---- One-click Gmail and Outlook sign-in (optional) -------------------------
# Needs your own Composio account. Without it, connect mailboxes with SMTP/IMAP.
# docs/self-hosting/mailboxes.md
#COMPOSIO_API_KEY=
#COMPOSIO_WEBHOOK_SECRET=
#COMPOSIO_GMAIL_AUTH_CONFIG_ID=
#COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=

# ---- Advanced (the defaults are right for a 2 GB server) ---------------------
#LOG_LEVEL=info
#BACKUP_KEEP=14
#BACKUP_HOUR_UTC=3
# Set to true only if your mail server has a private (LAN) address.
#SMTP_ALLOW_PRIVATE_HOSTS=false
# Send an email to this address whenever someone signs up. Off by default.
#FOUNDER_ALERT_EMAIL=
