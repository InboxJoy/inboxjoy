NODE_ENV=development
# Which product this is: selfhost (the open-source edition, the default in
# development and tests) or cloud (our hosted service: licence gate, billing,
# marketing pages). Production must set it explicitly. Set cloud here to try
# the paid flows locally.
INBOXJOY_EDITION=selfhost
# open: anyone can sign up. invite: the first account, then invitations only.
# Defaults: cloud open, selfhost invite.
#SIGNUP_MODE=invite
# Self-host only: while no account exists, the owner account can only be
# created from /app/setup?token=<this value>. At least 24 characters.
#SETUP_TOKEN=
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
AZURE_COMMUNICATION_EMAIL_SENDER=
AZURE_COMMUNICATION_EMAIL_REPLY_TO_ADDRESS=
AZURE_COMMUNICATION_EMAIL_MANAGED_IDENTITY_CLIENT_ID=

API_HOST=0.0.0.0
API_PORT=4000
WORKER_HEALTH_PORT=4001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inboxjoy?sslmode=disable

# Add real values only to .env or Azure Key Vault. Never commit secrets.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_TOOLKIT_VERSION=20260826_00
AUTH_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000/v1/auth

# System email (password resets, invitations, alerts) over plain SMTP. Production
# needs this or Azure Communication Services above.
# docs/self-hosting/system-email.md
#MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
#MAIL_FROM=noreply@example.com
#MAIL_REPLY_TO=

# AI drafting with any OpenAI-compatible endpoint (optional). Azure OpenAI above
# stays available for our cloud. docs/self-hosting/ai.md
#AI_API_KEY=
#AI_MODEL=
#AI_BASE_URL=https://api.openai.com/v1

# Connect any mailbox with SMTP/IMAP app passwords. The key is a base64 32-byte
# value: openssl rand -base64 32
#SMTP_MAILBOXES_ENABLED=true
#MAILBOX_CREDENTIALS_KEY=

# Emails the founder when someone signs up. Off when unset.
#FOUNDER_ALERT_EMAIL=
