{
  "name": "inboxjoy",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "InboxJoy email sequencing platform",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --stream --parallel --filter @inboxjoy/web --filter @inboxjoy/api --filter @inboxjoy/worker dev",
    "dev:web": "pnpm --filter @inboxjoy/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @inboxjoy/api dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @inboxjoy/worker dev",
    "build:packages": "pnpm --filter './packages/*' --if-present build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "node --test deploy/deploy.test.mjs && pnpm -r --if-present test",
    "db:generate": "pnpm --filter @inboxjoy/db generate",
    "db:migrate": "pnpm --filter @inboxjoy/db migrate",
    "db:studio": "pnpm --filter @inboxjoy/db studio"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
